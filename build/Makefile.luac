# Makefile.luac — builds build/bin/aotc.exe, the LuaC AOT compiler driver.
#
# Run from the project root:  make -f build/Makefile.luac aotc
# (build/build-luac.bat sets the MinGW + make PATH first, and builds the base
#  products/objects this links against.)
#
# aotc.exe = the backend objects (src/{ir,opt,codegen,link,driver}) + the reused
# front-end objects (src/compiler/{resolve,lua_compile,paths,diag}) + liblua54.a.
# The driver's main.c is compiled SEPARATELY with -DLUAC_AOTC_STANDALONE into a
# dedicated obj (build/bin/obj-aotc/main.o) so a real main() exists; the plain
# obj/driver/main.o (no main, just lc_drive) is excluded from the link to avoid
# a duplicate lc_drive symbol.

SHELL       := cmd.exe

CC          := x86_64-w64-mingw32-gcc
AR          := ar

ROOT        := .
BUILD_DIR   := $(ROOT)/build/bin
SRC_DIR     := $(ROOT)/clua/src
LUA_DIR     := $(ROOT)/lua-5.4/src

CFLAGS      := -std=c99 -Wall -Wextra -Wno-unused-parameter -O2 -g
CFLAGS      += -I$(SRC_DIR) -I$(LUA_DIR) -I$(ROOT)/build/gen
CFLAGS      += -DCLUA_TARGET_WINDOWS_X64=1

# Compiler-generated header dependencies; see the long note in build/Makefile.
# This file must carry it too: driver/aotc.h defines LcDriverOptions and is
# included by BOTH driver/main.c (compiled by the base Makefile) and the
# standalone objects compiled here. Tracking only one of them would rebuild
# obj/driver/main.o while obj-aotc/clua_main.o stayed stale, linking two
# different views of the same struct -- silent, and exactly the class of failure
# this change exists to remove.
DEPFLAGS    := -MMD -MP
CFLAGS      += $(DEPFLAGS)

# Backend objects produced by the base Makefile's `luac-objs` target. We link
# all of them EXCEPT the plain driver/main.o (its lc_drive is also compiled into
# the standalone obj below, and it has no main()).
BACKEND_OBJS := \
    $(wildcard $(BUILD_DIR)/obj/ir/*.o)      \
    $(wildcard $(BUILD_DIR)/obj/opt/*.o)     \
    $(wildcard $(BUILD_DIR)/obj/codegen/*.o) \
    $(wildcard $(BUILD_DIR)/obj/link/*.o)    \
    $(wildcard $(BUILD_DIR)/obj/dump/*.o)    \
    $(BUILD_DIR)/obj/driver/closed_world.o   \
    $(BUILD_DIR)/obj/driver/lc_undump.o      \
    $(BUILD_DIR)/obj/driver/supported_ops.o  \
    $(BUILD_DIR)/obj/driver/compdb.o

# Front-end objects the driver calls (produced by the base Makefile's `compiler`
# target). The driver does NOT use blob.o / pe_link.o (those are v1-only), but
# linking them in is harmless; we list only what lc_drive references.
FRONTEND_OBJS := \
    $(BUILD_DIR)/obj/compiler/resolve.o    \
    $(BUILD_DIR)/obj/compiler/lua_compile.o \
    $(BUILD_DIR)/obj/compiler/paths.o      \
    $(BUILD_DIR)/obj/compiler/diag.o       \
    $(BUILD_DIR)/obj/compiler/diag_pretty.o \
    $(BUILD_DIR)/obj/compiler/diag_suggest.o \
    $(BUILD_DIR)/obj/compiler/warn_unused.o

# Standalone driver main (with main()).
AOTC_MAIN_OBJ := $(BUILD_DIR)/obj-aotc/main.o

$(BUILD_DIR)/obj-aotc:
	if not exist "$(BUILD_DIR)\obj-aotc" mkdir "$(BUILD_DIR)\obj-aotc"

$(AOTC_MAIN_OBJ): $(SRC_DIR)/driver/main.c | $(BUILD_DIR)/obj-aotc
	$(CC) $(CFLAGS) -DLUAC_AOTC_STANDALONE -c $< -o $@

$(BUILD_DIR)/aotc.exe: $(AOTC_MAIN_OBJ) $(BACKEND_OBJS) $(FRONTEND_OBJS) $(BUILD_DIR)/liblua54.a
	$(CC) $(CFLAGS) -o $@ $(AOTC_MAIN_OBJ) $(BACKEND_OBJS) $(FRONTEND_OBJS) \
	    $(BUILD_DIR)/liblua54.a -lm -lkernel32 -ladvapi32

.PHONY: aotc
aotc: $(BUILD_DIR)/aotc.exe

# --- precompiled AOT entry object -------------------------------------------
# main() + the AOT dispatch hook + the closed-world stubs for every compiled
# program. Built ONCE here so user builds skip the per-program gcc compile;
# pe_link_v2.c resolves it next to the archives (and falls back to compiling
# the source in a cold tree). Flags must match the embedded archives' ABI
# surface: include dirs + CLUA_TARGET_WINDOWS_X64 (+ LUA_COMPAT_5_3) govern
# the Lua struct layouts.
# The size flags below match build/Makefile's EMBEDDED_RT_CFLAGS. This object was
# the only one of ours compiled with NO -O and no -ffunction-sections, which cost
# 3 KB in every emitted PE and made it the exe's only real .pdata/.xdata producer
# (372 + 364 bytes of unwind tables that AOT-generated functions never emit).
# None of these flags touch the ABI surface -- the include dirs and the two -D
# defines are what govern the Lua struct layouts, and they are unchanged.
$(BUILD_DIR)/aot_entry.o: $(SRC_DIR)/runtime/aot_entry.c
	$(CC) -std=c99 -I$(SRC_DIR) -I$(LUA_DIR) \
	    -DCLUA_TARGET_WINDOWS_X64=1 -DLUA_COMPAT_5_3 \
	    -Os -g0 -ffunction-sections -fno-asynchronous-unwind-tables \
	    -fno-unwind-tables -fmerge-all-constants -fmerge-constants \
	    -fstack-protector-strong -fcf-protection=none \
	    $(DEPFLAGS) -c $< -o $@

.PHONY: aot-entry
aot-entry: $(BUILD_DIR)/aot_entry.o

# --- aot_entry_dll.o — entry object for --output=dll ------------------------
# Same compile knobs as aot_entry.o above (size + no async unwind), just a
# different source file. Provides Rt_DllMain plus the shared export
# dispatcher Rt_DllExportDispatch (tail-jumped into by every per-export
# trampoline the internal linker synthesises) and the closed-world stubs.
# See clua/src/runtime/aot_entry_dll.c for the shape.
$(BUILD_DIR)/aot_entry_dll.o: $(SRC_DIR)/runtime/aot_entry_dll.c
	$(CC) -std=c99 -I$(SRC_DIR) -I$(LUA_DIR) \
	    -DCLUA_TARGET_WINDOWS_X64=1 -DLUA_COMPAT_5_3 \
	    -Os -g0 -ffunction-sections -fno-asynchronous-unwind-tables \
	    -fno-unwind-tables -fmerge-all-constants -fmerge-constants \
	    -fstack-protector-strong -fcf-protection=none \
	    $(DEPFLAGS) -c $< -o $@

.PHONY: aot-entry-dll
aot-entry-dll: $(BUILD_DIR)/aot_entry_dll.o

# --- clua.exe — the user-facing toolchain front-end --------------------------
# Same pipeline as aotc.exe (shared lc_drive in the plain obj/driver/main.o,
# which has no main()), plus the subcommand CLI compiled standalone.
CLUA_MAIN_OBJ := $(BUILD_DIR)/obj-aotc/clua_main.o

$(CLUA_MAIN_OBJ): $(SRC_DIR)/driver/clua_main.c | $(BUILD_DIR)/obj-aotc
	$(CC) $(CFLAGS) -DLUAC_CLUA_STANDALONE -c $< -o $@

$(BUILD_DIR)/clua.exe: $(CLUA_MAIN_OBJ) $(BUILD_DIR)/obj/driver/main.o $(BACKEND_OBJS) $(FRONTEND_OBJS) $(BUILD_DIR)/liblua54.a $(BUILD_DIR)/aot_entry.o
	$(CC) $(CFLAGS) -o $@ $(CLUA_MAIN_OBJ) $(BUILD_DIR)/obj/driver/main.o \
	    $(BACKEND_OBJS) $(FRONTEND_OBJS) \
	    $(BUILD_DIR)/liblua54.a -lm -lkernel32 -ladvapi32

.PHONY: clua
clua: $(BUILD_DIR)/clua.exe

# --- rover.exe — the CLua package manager, compiled by CLua itself -----------
# Dogfood: rover is an AOT-compiled closed-world Lua program (the largest
# fidelity fixture in the tree). clua.exe now defaults to the built-in linker,
# so rover links with NO gcc — it only needs the archives + aot_entry.o + the
# CRT sysroot snapshot (built by the `sysroot` target, ordered before this in
# build-luac.bat; an explicit dep here keeps a direct `make rover` honest).
# runtime-aot.a is listed too: rover is a CLua-compiled PE that *links* that
# archive, so a runtime/core rebuild (e.g. a CFLAGS change) must relink rover —
# without this dep a stale rover silently ships against the old runtime.
$(BUILD_DIR)/rover.exe: $(BUILD_DIR)/clua.exe $(BUILD_DIR)/aot_entry.o $(BUILD_DIR)/runtime-aot.a $(BUILD_DIR)/sysroot/libkernel32.a $(ROOT)/rover/src/rover.lua
	$(BUILD_DIR)/clua.exe build $(ROOT)/rover/src/rover.lua -O1 -o $@

# sysroot snapshot probe (built by the `sysroot` target); a file dep so
# `make rover` rebuilds the snapshot first when it is missing.
$(BUILD_DIR)/sysroot/libkernel32.a:
	powershell -NoProfile -ExecutionPolicy Bypass -File build/make-sysroot.ps1 -DestDir "$(BUILD_DIR)/sysroot"

.PHONY: rover
rover: $(BUILD_DIR)/rover.exe

# --- sysroot — the CRT snapshot the internal linker (--ld=internal) links ----
# Locates each MinGW CRT piece ONCE via gcc -print-file-name and copies it into
# build/bin/sysroot, so internal-mode builds run with no gcc on PATH. pe_link_v2.c
# discovers this dir as <archives-dir>\sysroot (build\bin\sysroot in the repo,
# lib\sysroot in a dist).
.PHONY: sysroot
sysroot:
	powershell -NoProfile -ExecutionPolicy Bypass -File build/make-sysroot.ps1 -DestDir "$(BUILD_DIR)/sysroot"

# --- dist — the user-facing distribution layout ------------------------------
#   dist\clua.exe  dist\rover.exe  dist\lib\{runtime-aot.a,liblua54-embedded.a,
#   aot_entry.o}  dist\README.txt  dist\lib\sysroot\ (for --ld=internal)
# No headers ship: the ProtoInit blob killed the generated-C compile step, so
# a user build is front-end + in-process codegen + ONE native link.
.PHONY: dist
dist: $(BUILD_DIR)/clua.exe $(BUILD_DIR)/rover.exe $(BUILD_DIR)/aot_entry.o $(BUILD_DIR)/aot_entry_dll.o
	if not exist "$(ROOT)\dist\lib" mkdir "$(ROOT)\dist\lib"
	powershell -NoProfile -ExecutionPolicy Bypass -File build/make-sysroot.ps1 -DestDir "$(ROOT)/dist/lib/sysroot"
	copy /Y "$(BUILD_DIR)\clua.exe"            "$(ROOT)\dist\clua.exe" >nul
	copy /Y "$(BUILD_DIR)\rover.exe"           "$(ROOT)\dist\rover.exe" >nul
	copy /Y "$(BUILD_DIR)\runtime-aot.a"       "$(ROOT)\dist\lib\runtime-aot.a" >nul
	copy /Y "$(BUILD_DIR)\liblua54-embedded.a" "$(ROOT)\dist\lib\liblua54-embedded.a" >nul
	copy /Y "$(BUILD_DIR)\aot_entry.o"         "$(ROOT)\dist\lib\aot_entry.o" >nul
	copy /Y "$(BUILD_DIR)\aot_entry_dll.o"     "$(ROOT)\dist\lib\aot_entry_dll.o" >nul
	copy /Y "$(BUILD_DIR)\lvm_nointerp.o"      "$(ROOT)\dist\lib\lvm_nointerp.o" >nul
	copy /Y "$(BUILD_DIR)\clua-rt.dll"         "$(ROOT)\dist\lib\clua-rt.dll" >nul
	copy /Y "$(BUILD_DIR)\libclua-rt.dll.a"    "$(ROOT)\dist\lib\libclua-rt.dll.a" >nul
	copy /Y "$(BUILD_DIR)\protoinit_rt.o"      "$(ROOT)\dist\lib\protoinit_rt.o" >nul
	if not exist "$(ROOT)\dist\lib\packages" mkdir "$(ROOT)\dist\lib\packages"
	xcopy /E /I /Y /Q "$(ROOT)\clua\src\runtime\packages" "$(ROOT)\dist\lib\packages" >nul
	copy /Y "$(ROOT)\build\dist-README.txt"    "$(ROOT)\dist\README.txt" >nul
	copy /Y "$(ROOT)\LICENSE"                  "$(ROOT)\dist\LICENSE" >nul
	strip "$(ROOT)\dist\clua.exe"
	@echo [+] dist\ ready (clua.exe + rover.exe + lib\)

# --- release — versioned zip + SHA-256, from a fresh dist ---------------------
# The version is read straight out of clua/src/common/version.h so there is one
# source of truth (tools/bump-version.ps1 rewrites that header). Do NOT hardcode
# a version here.
.PHONY: release
release: dist
	powershell -NoProfile -ExecutionPolicy Bypass -File build/make-release.ps1 -VersionHeader "$(SRC_DIR)/common/version.h" -DistDir "$(ROOT)/dist" -OutDir "$(ROOT)"

# --- read back the header dependencies for the objects THIS file compiles -----
# At the END, for the same default-goal reason as in build/Makefile: a fragment's
# first target is an object, and this file's default goal must stay `aotc`.
# Scoped to the two places it compiles into: $(BUILD_DIR)/obj-aotc and the
# aot_entry.o sitting directly in $(BUILD_DIR). The base Makefile reads back the
# rest.
-include $(wildcard $(BUILD_DIR)/*.d)
-include $(wildcard $(BUILD_DIR)/obj-aotc/*.d)
