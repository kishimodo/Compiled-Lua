++/* TRUE iff any function MATERIALIZES the `package` table as a value.
++   `package.loaded` IS the registry's LOADED table -- the one container, other
++   than the globals table, that holds every opened standard library -- so a
++   program holding `package` can reach any library through a key the compiler
++   cannot see: package.loaded[k], or package[("load".."ed")][k]. Detecting the
++   moment `package` becomes a value is exactly the OP_GETTABUP _ENV "package"
++   shape (a computed "package" needs _G/_ENV materialized first, which
++   lc_module_reflects_globals covers). Conservative by string constant, like
++   the rest of this file: a table FIELD or a plain string spelled "package"
++   also trips it. */
++static bool lc_module_reflects_package(LcModule *m) {
++  for (uint32_t i = 0; i < m->nfuncs; i++) {
++    Proto *p = m->funcs[i] ? m->funcs[i]->source : NULL;
++    if (!p) continue;
++    for (int k = 0; k < p->sizek; k++) {
++      const TValue *kv = &p->k[k];
++      if (ttisstring(kv) && strcmp(getstr(tsvalue(kv)), "package") == 0)
++        return true;
++    }
++  }
++  return false;
++}
