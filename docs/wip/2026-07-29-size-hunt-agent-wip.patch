diff --cc clua/src/codegen/codegen.h
index 2cedd58,2cedd58..cd2c4ee
--- a/clua/src/codegen/codegen.h
+++ b/clua/src/codegen/codegen.h
@@@ -113,8 -113,8 +113,20 @@@ void          lc_codemodule_free(LcCode
  typedef struct LcCgFrame {
      int32_t savedpc_bias;  /* RBP = Proto.code + bias; cancels at every site   */
      int     save_xmm;      /* function uses float residency: spill xmm6-10     */
++    int     save_gpr;      /* function uses INT residency: push R12-R15/RSI.
++                              0 => those five are never written, so the frame
++                              is RDI/RBX/RBP only and the reserve is 0x20.
++                              Set by res_analyze BEFORE the prologue is
++                              emitted; the epilogue must read the SAME value. */
  } LcCgFrame;
  
++/* Stack reserve the prologue subtracts and every epilogue adds back. Must keep
++   RSP 16-aligned AT a CALL and cover the mandatory 32-byte Win64 shadow space.
++   save_gpr => 8 pushes (64) + return address (8) = 72 == 8 (mod 16) => 0x28.
++   otherwise => 3 pushes (24) + 8 = 32 == 0 (mod 16) => 0x20.
++   The xmm spill area is 0x50, a multiple of 16, so it never changes parity. */
++#define LC_CG_FRAME_RESERVE( F ) ( ( F )->save_gpr ? 0x28 : 0x20 )
++
  int LcCg_EmitPrologue        ( LcCodeBuf *B, const LcCgFrame *F );
  int LcCg_EmitEpilogue        ( LcCodeBuf *B, const LcCgFrame *F );
  int LcCg_EmitRestoreL        ( LcCodeBuf *B );  /* MOV RCX, RBX                               */
diff --cc clua/src/codegen/x64_emit.c
index 6f85e29,6f85e29..bb46f30
--- a/clua/src/codegen/x64_emit.c
+++ b/clua/src/codegen/x64_emit.c
@@@ -286,10 -286,10 +286,20 @@@ int X64Emit_PopReg( LcCodeBuf *Buf, X64
      return AppendByte( Buf, ( unsigned char )( 0x58 + Lo3( Reg ) ) );
  }
  
++/* SUB/ADD rsp, imm.  `83 /n ib` sign-extends its imm8 to 64 bits under REX.W,
++   so for every value in [-128,127] it leaves RSP bit-identical to what the
++   `81 /n id` form leaves -- 4 bytes instead of 7, with no flag, latency, or
++   uop difference. Every frame reserve the backend emits (0x28, 0x50) is in
++   range, so this is 3 bytes off every prologue and every epilogue. */
  int X64Emit_SubRspImm( LcCodeBuf *Buf, int32_t Imm )
  {
--    /* 48 81 EC id   SUB rsp, imm32   (always use imm32 form for simplicity) */
      if ( !AppendByte( Buf, REX_BASE | REX_W ) )                  return 0;
++    if ( Imm >= -128 && Imm <= 127 ) {                           /* 48 83 EC ib */
++        int8_t I8 = ( int8_t )Imm;
++        if ( !AppendByte( Buf, 0x83 ) )                          return 0;
++        if ( !AppendByte( Buf, ModRm( 3, 5, 4 ) ) )              return 0;
++        return AppendBytes( Buf, &I8, 1 );
++    }
      if ( !AppendByte( Buf, 0x81 ) )                              return 0;
      if ( !AppendByte( Buf, ModRm( 3, 5, 4 ) ) )                  return 0; /* /5, rm=rsp */
      return AppendBytes( Buf, &Imm, 4 );
@@@ -297,8 -297,8 +307,13 @@@
  
  int X64Emit_AddRspImm( LcCodeBuf *Buf, int32_t Imm )
  {
--    /* 48 81 C4 id   ADD rsp, imm32 */
      if ( !AppendByte( Buf, REX_BASE | REX_W ) )                  return 0;
++    if ( Imm >= -128 && Imm <= 127 ) {                           /* 48 83 C4 ib */
++        int8_t I8 = ( int8_t )Imm;
++        if ( !AppendByte( Buf, 0x83 ) )                          return 0;
++        if ( !AppendByte( Buf, ModRm( 3, 0, 4 ) ) )              return 0;
++        return AppendBytes( Buf, &I8, 1 );
++    }
      if ( !AppendByte( Buf, 0x81 ) )                              return 0;
      if ( !AppendByte( Buf, ModRm( 3, 0, 4 ) ) )                  return 0; /* /0, rm=rsp */
      return AppendBytes( Buf, &Imm, 4 );
