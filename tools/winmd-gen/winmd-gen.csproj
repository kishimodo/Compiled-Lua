<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CLua.WinmdGen</RootNamespace>
    <AssemblyName>winmd-gen</AssemblyName>
    <!-- Self-contained single-file publish so the resulting .exe runs
         without requiring a separate dotnet runtime install on the
         build host. The PS wrapper invokes `dotnet build` once and
         caches the output. -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
